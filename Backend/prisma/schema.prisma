generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TENANT
  SALES_AGENT
  PROPERTY_OWNER
}

enum CategoryProp {
  PG
  HOSTEL
  DORMITORY
  FLAT
  ROOM
}

enum PropertyStatus {
  DRAFT
  VERIFIED
  PUBLISHED_UNVERIFIED
  UNDER_VERIFICATION
  REJECTED
  HOLD
}

enum FollowUpChannel {
  EMAIL
  WHATSAPP
  PHONE_CALL
  ON_SITE
}

enum NotificationType {
  EMAIL
  WHATSAPP
}

enum MediaType {
  IMAGE
  VIDEO
}

enum EnquiryStatus {
  NEW
  ASSIGNED
  FOLLOWUP
  VISIT
  ENQUIRY_CLOSED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  fullName  String   @db.VarChar(255)
  role      Role     @default(TENANT)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  adminCreatedProperties Property[] @relation("AdminCreatedProperties")
  verifiedOwnedProperties Property[] @relation("OwnerVerifiedProperties")
  tenantEnquiries Enquiry[] @relation("TenantEnquiries")
  assignedEnquiries Enquiry[] @relation("SalesAssignedEnquiries")
  salesFollowups EnquiryFollowup[] @relation("SalesAgentFollowups")
  verificationAudits PropertyVerification[] @relation("ReviewVerifications")
  statusChanges PropertyStatusHistory[] @relation("UserStatusChanges")

  @@index([role, isActive])
}

model Property {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(255)
  description          String?   @db.Text
  category             CategoryProp
  verificationStatus   PropertyStatus @default(DRAFT) @map("verification_status")
  isPublished          Boolean   @default(false) @map("is_published")
  label                String    @default("PGfy Not Verified") @map("label") @db.VarChar(80)
  city                 String    @db.VarChar(120)
  locality             String    @db.VarChar(120)
  addressLine          String    @map("address_line") @db.Text
  pincode              String    @db.VarChar(12)
  rentMin              Int       @map("rent_min")
  rentMax              Int       @map("rent_max")
  securityDeposit      Int       @default(0) @map("security_deposit")
  ownerContactName     String    @map("owner_contact_name") @db.VarChar(120)
  ownerContactPhone    String    @map("owner_contact_phone") @db.VarChar(20)
  ownerContactEmail    String?   @map("owner_contact_email") @db.VarChar(255)
  normalizedDedupKey   String    @map("normalized_dedup_key") @db.VarChar(255)
  categoryDetails      Json      @default("{}") @map("category_details")
  amenities           String[]  @default([])
  createdByAdminId     String    @map("created_by_admin_id") @db.Uuid
  verifiedOwnerId      String?   @map("verified_owner_id") @db.Uuid
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz()
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  createdByAdmin       User     @relation("AdminCreatedProperties", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  verifiedOwner        User?    @relation("OwnerVerifiedProperties", fields: [verifiedOwnerId], references: [id], onDelete: SetNull)

  media                PropertyMedia[]
  enquiries            Enquiry[]
  verifications        PropertyVerification[]
  statusHistory        PropertyStatusHistory[]

  @@index([isPublished, verificationStatus, createdAt])
  @@index([city, locality])
  @@index([normalizedDedupKey, deletedAt])
}

model EnquiryFollowup {
  id             String    @id @default(uuid()) @db.Uuid
  enquiryId      String    @map("enquiry_id") @db.Uuid
  salesAgentId   String    @map("sales_agent_id") @db.Uuid
  channel        FollowUpChannel
  outcomeStatus  String    @map("outcome_status") @db.VarChar(80)
  notes          String    @db.Text
  nextFollowupAt DateTime? @map("next_followup_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  enquiry        Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  salesAgent     User    @relation("SalesAgentFollowups", fields: [salesAgentId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([salesAgentId, createdAt])
}

model Enquiry {
  id                    String        @id @default(uuid()) @db.Uuid
  propertyId            String        @map("property_id") @db.Uuid
  tenantUserId          String?       @map("tenant_user_id") @db.Uuid
  tenantName            String        @map("tenant_name") @db.VarChar(120)
  tenantPhone           String        @map("tenant_phone") @db.VarChar(20)
  tenantEmail           String?       @map("tenant_email") @db.VarChar(255)
  message               String?       @db.Text
  preferredMoveIn       DateTime?     @map("preferred_move_in") @db.Date
  occupancyPreference   String?       @map("occupancy_preference") @db.VarChar(80)
  status                EnquiryStatus @default(NEW)
  assignedSalesId       String?       @map("assigned_sales_id") @db.Uuid
  wasUnverifiedAtSubmit Boolean       @default(true) @map("was_unverified_at_submit")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  property              Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenantUser            User?             @relation("TenantEnquiries", fields: [tenantUserId], references: [id], onDelete: SetNull)
  assignedSales         User?             @relation("SalesAssignedEnquiries", fields: [assignedSalesId], references: [id], onDelete: SetNull)
  followups             EnquiryFollowup[]
  notifications         NotificationLog[]

  @@index([propertyId, tenantPhone, createdAt])
  @@index([assignedSalesId, status, createdAt])
}

model PropertyVerification {
  id               String    @id @default(uuid()) @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  reviewedByUserId String    @map("reviewed_by_user_id") @db.Uuid
  decision         PropertyStatus @default(UNDER_VERIFICATION) @map("decision")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewedByUser  User     @relation("ReviewVerifications", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt])
}

model PropertyStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  changedByUserId String         @map("changed_by_user_id") @db.Uuid
  fromStatus      PropertyStatus? @map("from_status")
  toStatus        PropertyStatus @map("to_status")
  reason          String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  changedByUser   User     @relation("UserStatusChanges", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt])
}

model PropertyMedia {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  mediaUrl  String    @map("media_url") @db.Text
  mediaType MediaType @default(IMAGE) @map("media_type")
  isPrimary Boolean   @default(false) @map("is_primary")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model NotificationLog {
  id                String         @id @default(uuid()) @db.Uuid
  enquiryId         String         @map("enquiry_id") @db.Uuid
  channel           NotificationType
  recipient         String         @db.VarChar(180)
  providerMessageId String?        @map("provider_message_id") @db.VarChar(160)
  deliveryStatus    DeliveryStatus  @default(QUEUED) @map("delivery_status")
  retryCount        Int            @default(0) @map("retry_count")
  errorMessage      String?        @map("error_message") @db.Text
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz()
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz()
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  enquiry           Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([deliveryStatus, createdAt])
  @@index([enquiryId, channel])
}
